{
	"private": true,
	"name": "@doars/doars-workspace",
	"workspaces": [
		"docs-src/",
		"packages/*",
		"performance/"
	],
	"type": "module",
	"scripts": {
		"build": "bun --filter=\"./packages/*\" run build",
		"check": "bun --filter=\"./packages/*\" run check",
		"check:write": "bun --filter=\"./packages/*\" run check:write",
		"serve": "bun ./helpers/serve.js ./"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.13",
		"@playwright/test": "^1.49.1",
		"brotli-size": "^4.0.0",
		"happy-dom": "^15.11.6"
	}
}
